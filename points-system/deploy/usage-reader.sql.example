\set ON_ERROR_STOP on

-- Run as a CREATEROLE-capable owner of the existing Sub2API database:
--   -v points_usage_role=points_usage_reader
--   -v points_usage_password='LONG_RANDOM_PASSWORD'
-- The script is idempotent, rotates the password, removes role memberships,
-- and grants column-level read access only to the existing usage_logs table.

SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', :'points_usage_role', :'points_usage_password')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'points_usage_role')
\gexec
SELECT format(
    'ALTER ROLE %I WITH LOGIN PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT CONNECTION LIMIT 4',
    :'points_usage_role', :'points_usage_password'
)
\gexec
SELECT format('REVOKE %I FROM %I', parent.rolname, :'points_usage_role')
FROM pg_auth_members membership
JOIN pg_roles parent ON parent.oid = membership.roleid
JOIN pg_roles child ON child.oid = membership.member
WHERE child.rolname = :'points_usage_role'
\gexec

SELECT format('ALTER ROLE %I SET default_transaction_read_only = %L', :'points_usage_role', 'on')
\gexec
SELECT format('ALTER ROLE %I SET statement_timeout = %L', :'points_usage_role', '30s')
\gexec
SELECT format('ALTER ROLE %I SET idle_in_transaction_session_timeout = %L', :'points_usage_role', '30s')
\gexec

SELECT format('GRANT CONNECT ON DATABASE %I TO %I', current_database(), :'points_usage_role')
\gexec
SELECT format('GRANT USAGE ON SCHEMA public TO %I', :'points_usage_role')
\gexec
SELECT format('REVOKE CREATE ON SCHEMA public FROM %I', :'points_usage_role')
\gexec
SELECT format('REVOKE ALL PRIVILEGES ON ALL TABLES IN SCHEMA public FROM %I', :'points_usage_role')
\gexec
SELECT format('REVOKE ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public FROM %I', :'points_usage_role')
\gexec
SELECT format('REVOKE ALL PRIVILEGES ON ALL FUNCTIONS IN SCHEMA public FROM %I', :'points_usage_role')
\gexec
SELECT format(
    'GRANT SELECT (id, user_id, billing_type, actual_cost, created_at) ON TABLE public.usage_logs TO %I',
    :'points_usage_role'
)
\gexec
