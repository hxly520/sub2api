\set ON_ERROR_STOP on

-- Run exactly once as the PostgreSQL bootstrap superuser. Preload these psql
-- variables from a root-only file on stdin:
--   points_app_role, points_app_password, points_schema
-- The role and schema must not already exist. Any partial failure rolls back.

BEGIN;

CREATE EXTENSION IF NOT EXISTS btree_gist WITH SCHEMA public;

SELECT format(
    'CREATE ROLE %I WITH LOGIN PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT CONNECTION LIMIT 8',
    :'points_app_role', :'points_app_password'
)
\gexec
SELECT format('CREATE SCHEMA %I AUTHORIZATION %I', :'points_schema', :'points_app_role')
\gexec
SELECT format('REVOKE ALL ON SCHEMA %I FROM PUBLIC', :'points_schema')
\gexec
SELECT format('GRANT USAGE, CREATE ON SCHEMA %I TO %I', :'points_schema', :'points_app_role')
\gexec
SELECT format('GRANT CONNECT ON DATABASE %I TO %I', current_database(), :'points_app_role')
\gexec
SELECT format('GRANT USAGE ON SCHEMA public TO %I', :'points_app_role')
\gexec
SELECT format('ALTER ROLE %I SET statement_timeout = %L', :'points_app_role', '30s')
\gexec
SELECT format('ALTER ROLE %I SET idle_in_transaction_session_timeout = %L', :'points_app_role', '30s')
\gexec

-- Fail closed when PUBLIC grants would give the fresh role write or Sub2API
-- table access outside its isolated schema. Do not revoke shared production
-- ACLs automatically.
SELECT format($audit_sql$
DO $audit$
BEGIN
    IF has_database_privilege(%L, current_database(), 'CREATE') THEN
        RAISE EXCEPTION 'points role inherits CREATE on the shared database';
    END IF;
    IF has_schema_privilege(%L, 'public', 'CREATE') THEN
        RAISE EXCEPTION 'points role inherits CREATE on public schema';
    END IF;
    IF EXISTS (
        SELECT 1
        FROM pg_class relation
        JOIN pg_namespace namespace ON namespace.oid = relation.relnamespace
        WHERE namespace.nspname = 'public'
          AND relation.relkind IN ('r','p','v','m','f')
          AND (
              has_table_privilege(%L, relation.oid, 'SELECT') OR
              has_table_privilege(%L, relation.oid, 'INSERT') OR
              has_table_privilege(%L, relation.oid, 'UPDATE') OR
              has_table_privilege(%L, relation.oid, 'DELETE') OR
              has_table_privilege(%L, relation.oid, 'TRUNCATE') OR
              has_table_privilege(%L, relation.oid, 'REFERENCES') OR
              has_table_privilege(%L, relation.oid, 'TRIGGER')
          )
    ) THEN
        RAISE EXCEPTION 'points role inherits privileges on public relations';
    END IF;
END
$audit$;
$audit_sql$, :'points_app_role', :'points_app_role', :'points_app_role',
    :'points_app_role', :'points_app_role', :'points_app_role', :'points_app_role',
    :'points_app_role', :'points_app_role')
\gexec

-- The points workspaces need the stable internal user key, the display-only
-- username, and the soft-delete marker. They must not read email, balance,
-- credentials, group membership, or any other Sub2API user column.
SELECT format(
    'GRANT SELECT (id, username, deleted_at) ON TABLE public.users TO %I',
    :'points_app_role'
)
\gexec

COMMIT;
