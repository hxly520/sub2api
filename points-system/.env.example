POINTS_LISTEN_ADDR=:8090
POINTS_HOST_PORT=8090
POINTS_IMAGE=ghcr.io/hxly520/sub2api-points@sha256:REPLACE_WITH_64_HEX_DIGEST
SUB2API_DOCKER_NETWORK=SUB2API_COMPOSE_PROJECT_sub2api-network
# Keep this value identical to the password in POINTS_DATABASE_URL.
POINTS_DB_PASSWORD=CHANGE_ME
POINTS_DATABASE_URL=postgres://points:CHANGE_ME@postgres:5432/points?sslmode=disable
# Dedicated PostgreSQL credentials must have SELECT-only access to Sub2API usage_logs.
POINTS_USAGE_DATABASE_URL=postgres://points_reader:CHANGE_ME@sub2api-postgres:5432/sub2api?sslmode=disable
POINTS_USAGE_RECONCILE_DAYS=7
POINTS_PUBLIC_ORIGIN=https://points.example.com
# Replace with the exact Docker bridge gateway /32 observed by the points container.
POINTS_TRUSTED_PROXY_CIDR=172.20.0.1/32
POINTS_TIMEZONE=Asia/Shanghai
POINTS_COOKIE_SECURE=true
POINTS_SESSION_TTL=8h
POINTS_SESSION_SECRET=BASE64URL_32_BYTE_SECRET
POINTS_LAUNCH_ISSUER=sub2api
POINTS_LAUNCH_AUDIENCE=points-system
POINTS_LAUNCH_HMAC_KEYS=current:BASE64URL_32_BYTE_SECRET
POINTS_SUB2_BALANCE_URL=http://sub2api:8080
POINTS_SUB2_CREDIT_KEY_ID=v1
POINTS_SUB2_CREDIT_SECRET=BASE64URL_32_BYTE_SECRET
POINTS_HTTP_TIMEOUT=10s
POINTS_WORKER_INTERVAL=5s
