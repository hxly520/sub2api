# Points is reachable only through a one-time launch ticket issued by Sub2API.
# Only /launch disables access logging because its query carries the ticket.
server {
    listen 80;
    server_name points.52token.org;

    if ($sub2api_cloudflare_peer = 0) { return 444; }

    location = /launch {
        # Redirect requests can still contain a launch ticket in the query.
        access_log off;
        return 301 https://$host$request_uri;
    }

    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name points.52token.org;

    if ($sub2api_cloudflare_peer = 0) { return 444; }

    ssl_certificate     /etc/nginx/cert/52token.org.pem;
    ssl_certificate_key /etc/nginx/cert/52token.org.key;
    ssl_session_timeout 5m;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 2m;
    client_body_timeout 15s;
    proxy_connect_timeout 5s;
    proxy_read_timeout 35s;
    proxy_send_timeout 35s;

    location = /launch {
        limit_except GET { deny all; }
        access_log off;

        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
    }

    location = /healthz { return 404; }

    location ^~ /app/ {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
    }

    location ^~ /admin/ {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
    }

    location ^~ /assets/ {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
    }

    location ^~ /api/v1/ {
        limit_except GET POST OPTIONS { deny all; }
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
    }

    location / { return 404; }
}
